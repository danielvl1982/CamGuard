@page "/"
@rendermode InteractiveServer

@using Enrollment.Domain
@inject IServiceScopeFactory ScopeFactory
@inject ILogger<Home> Logger

@* InteractiveServer: the incidents preview filter needs event handlers. Scoped
   IIncidentRepository is never injected into the circuit (Members.razor/Incidents.razor
   precedent) — one short scope is created per load. *@
<PageTitle>CamGuard — Face enrollment for access control</PageTitle>

<section class="max-w-2xl">
    <h1 class="text-3xl font-bold tracking-tight text-text">Secure access with face enrollment</h1>
    <p class="mt-2 text-lg text-text-muted">Enroll faces once and recognize them at the door — CamGuard handles access control.</p>
    <div class="mt-6 flex flex-wrap gap-3">
        <a href="/members" class="rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-accent-contrast transition-colors hover:bg-accent-hover">Enroll a face</a>
    </div>
</section>

<section class="mt-8 grid gap-4 sm:grid-cols-2" aria-label="Get started">
    <a href="/members" class="block rounded-lg border border-border bg-elevated p-6 transition-all duration-150 hover:border-border-strong motion-safe:hover:-translate-y-0.5 motion-safe:hover:shadow-lg">
        <h2 class="text-lg font-semibold text-text">Members</h2>
        <p class="mt-2 text-sm text-text-muted">Enroll new members and manage the enrolled ones.</p>
    </a>
    <a href="/roles" class="block rounded-lg border border-border bg-elevated p-6 transition-all duration-150 hover:border-border-strong motion-safe:hover:-translate-y-0.5 motion-safe:hover:shadow-lg">
        <h2 class="text-lg font-semibold text-text">Roles</h2>
        <p class="mt-2 text-sm text-text-muted">Choose how each role is notified when a member is recognized.</p>
    </a>
</section>

<section class="mt-8 rounded-lg border border-border bg-elevated p-6 transition-all duration-150 hover:border-border-strong motion-safe:hover:-translate-y-0.5 motion-safe:hover:shadow-lg" aria-label="Recent incidents">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-lg font-semibold text-text">Recent incidents</h2>
        <a href="/incidents" class="text-sm font-semibold text-accent transition-colors hover:text-accent-hover">View all →</a>
    </div>

    <div class="mt-4 flex flex-wrap gap-3">
        <label class="text-sm text-text">
            Kind
            <select @bind="kindFilter" class="mt-1 block rounded border border-border bg-base px-3 py-2 text-sm text-text">
                <option value="">All kinds</option>
                @foreach (var kind in Enum.GetValues<IncidentKind>())
                {
                    <option value="@kind">@kind</option>
                }
            </select>
        </label>
        <label class="min-w-[12rem] flex-1 text-sm text-text">
            Search note
            <input @bind="noteFilter" @bind:event="oninput" type="text" placeholder="Filter by note text…" class="mt-1 block w-full rounded border border-border bg-base px-3 py-2 text-sm text-text" />
        </label>
    </div>

    <div class="mt-4" aria-live="polite">
        @if (isLoading)
        {
            <p class="text-sm text-text-muted" role="status">Loading incidents…</p>
        }
        else if (loadError is not null)
        {
            <p class="validation-message text-sm" role="alert">@loadError</p>
        }
        else if (FilteredIncidents.Count == 0)
        {
            <div class="rounded-lg border border-border bg-surface p-6 text-center" role="status">
                <p class="text-text-muted">No incidents match the current filter.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto rounded-lg border border-border bg-surface">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="bg-elevated text-left">
                            <th scope="col" class="px-4 py-3 font-semibold text-text">Date / time (UTC)</th>
                            <th scope="col" class="px-4 py-3 font-semibold text-text">Kind</th>
                            <th scope="col" class="px-4 py-3 font-semibold text-text">Note</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var incident in FilteredIncidents)
                        {
                            <tr @key="incident.Id" class="border-t border-border">
                                <td class="px-4 py-3 text-text-muted"><code>@incident.OccurredAtUtc.ToString("u")</code></td>
                                <td class="px-4 py-3 text-text"><span class="rounded border border-border px-2 py-1 text-sm">@incident.Kind</span></td>
                                <td class="px-4 py-3 text-text">@(incident.Note ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

@code {
    private const int PreviewLimit = 20;

    private IReadOnlyList<Incident>? incidents;
    private string? loadError;
    private bool isLoading = true;
    private string kindFilter = "";
    private string? noteFilter;

    private IReadOnlyList<Incident> FilteredIncidents =>
        (incidents ?? Array.Empty<Incident>())
            .Where(i => string.IsNullOrEmpty(kindFilter) || i.Kind.ToString() == kindFilter)
            .Where(i => string.IsNullOrWhiteSpace(noteFilter) ||
                        (i.Note?.Contains(noteFilter, StringComparison.OrdinalIgnoreCase) ?? false))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var repository = scope.ServiceProvider.GetRequiredService<IIncidentRepository>();
            incidents = await repository.ListRecentAsync(PreviewLimit, CancellationToken.None);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load the incidents preview on Home.");
            loadError = "The incident list could not be loaded. Refresh the page to try again.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
