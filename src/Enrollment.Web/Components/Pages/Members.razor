@page "/members"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using Enrollment.Domain
@inject IServiceScopeFactory ScopeFactory
@inject ILogger<Members> Logger

@* InteractiveServer: the per-row Annul action needs event handlers. Scoped
   IMemberVectorRepository is never injected into the circuit (Register.razor
   precedent) — one short scope is created per load/annul action instead. *@
<PageTitle>Members</PageTitle>

<div class="mx-auto w-full max-w-3xl">
    <h1 class="mb-6 text-xl font-semibold text-text">Members</h1>

    @if (notice is not null)
    {
        @if (noticeIsError)
        {
            <p class="validation-message text-sm" role="alert">@notice</p>
        }
        else
        {
            <div class="mb-6 rounded-lg border border-border bg-surface p-4" role="status">
                <p class="text-sm text-text">@notice</p>
            </div>
        }
    }

    @if (isLoading)
    {
        <p class="text-sm text-text-muted" role="status">Loading members…</p>
    }
    else if (loadError is not null)
    {
        <p class="validation-message text-sm" role="alert">@loadError</p>
    }
    else if (members is { Count: 0 })
    {
        <div class="rounded-lg border border-border bg-surface p-6 text-center" role="status">
            <p class="text-text-muted">No members are enrolled yet.</p>
            <div class="mt-3">
                <a href="/register" class="rounded bg-accent px-4 py-2 font-semibold text-accent-contrast transition-colors hover:bg-accent-hover">Register a member</a>
            </div>
        </div>
    }
    else if (members is not null)
    {
        <div class="overflow-x-auto rounded-lg border border-border bg-surface">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-elevated text-left">
                        <th scope="col" class="px-4 py-3 font-semibold text-text">Full name</th>
                        <th scope="col" class="px-4 py-3 font-semibold text-text">Member ID</th>
                        <th scope="col" class="px-4 py-3 font-semibold text-text">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in members)
                    {
                        <tr @key="member.Id" class="border-t border-border transition-colors hover:bg-surface">
                            <td class="px-4 py-3 text-text"><a href="@($"/members/{member.Id}")">@member.FullName</a></td>
                            <td class="px-4 py-3 text-text-muted"><code>@member.Id</code></td>
                            <td class="px-4 py-3 text-text">
                                @if (pendingAnnulId is not null && pendingAnnulId.Equals(member.Id))
                                {
                                    <span class="text-sm text-text-muted">¿Confirmar anulación?</span>
                                    <button type="button"
                                            class="rounded border border-border px-2 py-1 text-sm text-text-muted transition-colors hover:bg-surface hover:text-text"
                                            disabled="@(isAnnulling ? "disabled" : null)"
                                            @onclick="() => ConfirmAnnulAsync(member)">
                                        @(isAnnulling ? "Anulando…" : "Sí, anular")
                                    </button>
                                    <button type="button"
                                            class="rounded border border-border px-2 py-1 text-sm text-text-muted transition-colors hover:bg-surface hover:text-text"
                                            disabled="@(isAnnulling ? "disabled" : null)"
                                            @onclick="CancelAnnul">
                                        Cancelar
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            class="rounded border border-border px-2 py-1 text-sm text-text-muted transition-colors hover:bg-surface hover:text-text"
                                            disabled="@(isAnnulling ? "disabled" : null)"
                                            @onclick="() => ArmAnnul(member)">
                                        Anular
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private IReadOnlyList<Member>? members;
    private string? loadError;
    private bool isLoading = true;
    private MemberId? pendingAnnulId;
    private bool isAnnulling;
    private string? notice;
    private bool noticeIsError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var repository = scope.ServiceProvider.GetRequiredService<IMemberVectorRepository>();
            members = await repository.ListAllAsync(CancellationToken.None);
        }
        catch (Exception ex)
        {
            // Render an inline message instead of letting the failure take down the page.
            Logger.LogError(ex, "Failed to load the member directory.");
            loadError = "The member list could not be loaded. Refresh the page to try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ArmAnnul(Member member)
    {
        if (isAnnulling)
        {
            return;
        }

        pendingAnnulId = member.Id;
        notice = null;
    }

    private void CancelAnnul()
    {
        if (isAnnulling)
        {
            return;
        }

        pendingAnnulId = null;
    }

    private async Task ConfirmAnnulAsync(Member member)
    {
        if (isAnnulling)
        {
            return;
        }

        isAnnulling = true;
        notice = null;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var repository = scope.ServiceProvider.GetRequiredService<IMemberVectorRepository>();
            await repository.SetAnnulledAsync(member.Id, true, CancellationToken.None);
            pendingAnnulId = null;
            await LoadAsync();
            // ListAllAsync already excludes annulled members (T1), so the row
            // disappears on refresh — no client-side filtering needed.
            notice = $"El miembro '{member.FullName}' fue anulado.";
            noticeIsError = false;
        }
        catch (KeyNotFoundException)
        {
            notice = $"No se encontró el miembro '{member.FullName}'. Es posible que ya haya sido eliminado.";
            noticeIsError = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to annul member {MemberId}.", member.Id);
            notice = $"No se pudo anular a '{member.FullName}'. Vuelva a intentarlo.";
            noticeIsError = true;
        }
        finally
        {
            isAnnulling = false;
        }
    }
}
