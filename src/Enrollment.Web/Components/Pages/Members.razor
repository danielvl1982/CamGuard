@page "/members"
@rendermode InteractiveServer

@using Enrollment.Application
@using Enrollment.Domain
@inject IServiceScopeFactory ScopeFactory
@inject ILogger<Members> Logger

@* InteractiveServer: the per-row Annul action needs event handlers. Scoped
   IMemberVectorRepository and RegisterMemberCommandHandler are never injected into
   the circuit (Roles.razor precedent) — one short scope is created per load/annul/
   register action instead. *@
<PageTitle>Members</PageTitle>

<div class="mx-auto w-full max-w-3xl">
    <h1 class="mb-2 text-xl font-semibold text-text">Members</h1>
    <p class="mb-6 text-sm text-text-muted">
        Register a new member with one or more photos, then manage the enrolled members below.
    </p>

    @if (notice is not null)
    {
        @if (noticeIsError)
        {
            <p class="validation-message mb-6 text-sm" role="alert">@notice</p>
        }
        else
        {
            <div class="mb-6 rounded-lg border border-border bg-surface p-4" role="status">
                <p class="text-sm text-text">@notice</p>
            </div>
        }
    }

    <form class="mb-6 rounded-lg border border-border bg-surface p-6"
          @onsubmit="SubmitAsync"
          @onsubmit:preventDefault="true">
        <h2 class="mb-2 text-xl font-semibold text-text">New member</h2>
        <div class="space-y-6">
            <div>
                <label for="fullName" class="mb-1 block text-sm font-medium text-text">Full name</label>
                <input id="fullName"
                       type="text"
                       class="block w-full rounded border border-border bg-elevated px-3 py-2 text-text"
                       placeholder="e.g. Ada Lovelace"
                       autocomplete="name"
                       @bind="fullName"
                       @bind:event="oninput"
                       @bind:after="() => nameError = null"
                       disabled="@(isSubmitting ? "disabled" : null)" />
                @if (nameError is not null)
                {
                    <p class="validation-message mt-1 text-sm" role="alert">@nameError</p>
                }
            </div>

            <div>
                <label for="photos" class="mb-1 block text-sm font-medium text-text">Photos</label>
                <p class="mb-2 text-sm text-text-muted">
                    Add one or more photos. Every photo must contain exactly one clearly visible face.
                </p>
                <InputFile id="photos"
                           multiple
                           accept="image/*"
                           OnChange="OnFilesChangedAsync"
                           disabled="@(isSubmitting ? "disabled" : null)" />
                @if (photoError is not null)
                {
                    <p class="validation-message mt-1 text-sm" role="alert">@photoError</p>
                }
                @if (selectionError is not null)
                {
                    <p class="validation-message mt-1 text-sm" role="alert">@selectionError</p>
                }

                @if (photos.Count > 0)
                {
                    <ul class="mt-3 grid gap-3 sm:grid-cols-2" role="list">
                        @foreach (var photo in photos)
                        {
                            <li @key="photo.Id" class="flex items-center gap-3 rounded border border-border bg-elevated p-3 transition-all duration-150 motion-safe:hover:-translate-y-0.5 motion-safe:hover:shadow-lg">
                                <div class="h-16 w-16 shrink-0 overflow-hidden rounded border border-border bg-surface">
                                    @if (photo.PreviewDataUrl is not null)
                                    {
                                        <img src="@photo.PreviewDataUrl" alt="Preview of @photo.File.Name" class="h-full w-full object-cover" />
                                    }
                                    else
                                    {
                                        <span class="flex h-full w-full items-center justify-center text-sm text-text-muted">No preview</span>
                                    }
                                </div>
                                <div class="min-w-0 flex-1">
                                    <p class="truncate text-sm text-text">@photo.File.Name</p>
                                    <p class="text-sm text-text-muted">@FormatSize(photo.File.Size)</p>
                                </div>
                                <button type="button"
                                        class="shrink-0 rounded border border-border px-2 py-1 text-sm text-text-muted transition-colors hover:bg-surface hover:text-text"
                                        disabled="@(isSubmitting ? "disabled" : null)"
                                        @onclick="() => RemovePhoto(photo)">
                                    Remove
                                </button>
                            </li>
                        }
                    </ul>
                }
            </div>

            <div class="flex flex-wrap items-center gap-4">
                <button type="submit"
                        class="rounded bg-accent px-4 py-2 font-semibold text-accent-contrast transition-colors hover:bg-accent-hover disabled:opacity-50"
                        disabled="@(isSubmitting ? "disabled" : null)">
                    @(isSubmitting ? "Registering…" : "Register member")
                </button>
                @if (isSubmitting)
                {
                    <span class="text-sm text-text-muted" role="status">Checking photos — face extraction can take a moment.</span>
                }
            </div>

            @if (submissionError is not null)
            {
                <p class="validation-message text-sm" role="alert">@submissionError</p>
            }
        </div>
    </form>

    @if (isLoading)
    {
        <p class="text-sm text-text-muted" role="status">Loading members…</p>
    }
    else if (loadError is not null)
    {
        <p class="validation-message text-sm" role="alert">@loadError</p>
    }
    else if (members is { Count: 0 })
    {
        <div class="rounded-lg border border-border bg-surface p-6 text-center" role="status">
            <p class="text-text-muted">No members are enrolled yet. Use the New member form above to add one.</p>
        </div>
    }
    else if (members is not null)
    {
        <div class="overflow-x-auto rounded-lg border border-border bg-surface">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-elevated text-left">
                        <th scope="col" class="px-4 py-3 font-semibold text-text">Full name</th>
                        <th scope="col" class="px-4 py-3 font-semibold text-text">Role</th>
                        <th scope="col" class="px-4 py-3 font-semibold text-text">Member ID</th>
                        <th scope="col" class="px-4 py-3 font-semibold text-text">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in members)
                    {
                        <tr @key="member.Id" class="border-t border-border transition-colors hover:bg-surface">
                            <td class="px-4 py-3 text-text"><a href="@($"/members/{member.Id}")">@member.FullName</a></td>
                            <td class="px-4 py-3 text-text-muted">@RoleName(member)</td>
                            <td class="px-4 py-3 text-text-muted"><code>@member.Id</code></td>
                            <td class="px-4 py-3 text-text">
                                @if (pendingAnnulId is not null && pendingAnnulId.Equals(member.Id))
                                {
                                    <span class="text-sm text-text-muted">Disable this member?</span>
                                    <button type="button"
                                            class="rounded border border-border px-2 py-1 text-sm text-text-muted transition-colors hover:bg-surface hover:text-text"
                                            disabled="@(isAnnulling ? "disabled" : null)"
                                            @onclick="() => ConfirmAnnulAsync(member)">
                                        @(isAnnulling ? "Disabling…" : "Yes, disable")
                                    </button>
                                    <button type="button"
                                            class="rounded border border-border px-2 py-1 text-sm text-text-muted transition-colors hover:bg-surface hover:text-text"
                                            disabled="@(isAnnulling ? "disabled" : null)"
                                            @onclick="CancelAnnul">
                                        Cancel
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            class="rounded border border-border px-2 py-1 text-sm text-text-muted transition-colors hover:bg-surface hover:text-text"
                                            disabled="@(isAnnulling ? "disabled" : null)"
                                            @onclick="() => ArmAnnul(member)">
                                        Disable
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private IReadOnlyList<Member>? members;
    private Dictionary<RoleId, string> roleNames = [];
    private string? loadError;
    private bool isLoading = true;
    private MemberId? pendingAnnulId;
    private bool isAnnulling;
    private string? notice;
    private bool noticeIsError;

    /// <summary>Upper bound per photo; matches the cap enforced by <see cref="IBrowserFile.OpenReadStream(long, CancellationToken)"/>.</summary>
    private const long MaxPhotoBytes = 50 * 1024 * 1024;

    private const int PreviewMaxDimension = 160;

    private string fullName = string.Empty;
    private string? nameError;
    private string? photoError;
    private string? selectionError;
    private string? submissionError;
    private bool isSubmitting;

    private readonly List<PhotoEntry> photos = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var repository = scope.ServiceProvider.GetRequiredService<IMemberVectorRepository>();
            members = await repository.ListAllAsync(CancellationToken.None);

            // One query for all roles; rows resolve names from this map (no N+1).
            var listRoles = scope.ServiceProvider.GetRequiredService<ListRolesQueryHandler>();
            var roles = await listRoles.HandleAsync(new ListRolesQuery(), CancellationToken.None);
            roleNames = roles.ToDictionary(role => role.Id, role => role.Name);
        }
        catch (Exception ex)
        {
            // Render an inline message instead of letting the failure take down the page.
            Logger.LogError(ex, "Failed to load the member directory.");
            loadError = "The member list could not be loaded. Refresh the page to try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    // "—" means no role assigned; a RoleId that no longer resolves is called out so it
    // reads the same as on the detail page instead of looking like an unassigned member.
    private string RoleName(Member member) =>
        member.RoleId is not { } roleId ? "—"
        : roleNames.TryGetValue(roleId, out var name) ? name
        : "Unknown role";

    private async Task OnFilesChangedAsync(InputFileChangeEventArgs e)
    {
        // The form controls are disabled while a submission is running, but guard
        // anyway so the photo list cannot mutate under an in-flight registration.
        if (isSubmitting || e.FileCount == 0)
        {
            return;
        }

        photoError = null;
        selectionError = null;

        // A new selection replaces the browser's file list, so handles from earlier
        // selections no longer exist client-side ("There is no file with ID N").
        // Keeping them would make the next submit fail.
        photos.Clear();

        var added = new List<PhotoEntry>();
        var rejected = new List<string>();
        foreach (var file in e.GetMultipleFiles(int.MaxValue))
        {
            if (file.Size > MaxPhotoBytes)
            {
                rejected.Add(file.Name);
                continue;
            }

            var entry = new PhotoEntry(file);
            photos.Add(entry);
            added.Add(entry);
        }

        if (rejected.Count > 0)
        {
            selectionError =
                $"These files exceed the {FormatSize(MaxPhotoBytes)} limit and were not added: {string.Join(", ", rejected)}.";
        }

        foreach (var entry in added)
        {
            await LoadPreviewAsync(entry);
        }
    }

    private async Task LoadPreviewAsync(PhotoEntry entry)
    {
        try
        {
            var format = PreviewFormat(entry.File.Name);
            var resized = await entry.File.RequestImageFileAsync(format, PreviewMaxDimension, PreviewMaxDimension);
            await using var stream = resized.OpenReadStream(MaxPhotoBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            var contentType = string.IsNullOrWhiteSpace(resized.ContentType) ? format : resized.ContentType;
            entry.PreviewDataUrl = $"data:{contentType};base64,{Convert.ToBase64String(buffer.ToArray())}";
        }
        catch (Exception ex)
        {
            // Preview is best-effort: a placeholder is rendered instead when the
            // browser cannot decode/resize the file.
            Logger.LogWarning(ex, "Preview generation failed for {FileName}.", entry.File.Name);
            entry.PreviewDataUrl = null;
        }
    }

    private void RemovePhoto(PhotoEntry photo)
    {
        if (isSubmitting)
        {
            return;
        }

        photos.Remove(photo);
        if (photos.Count > 0)
        {
            photoError = null;
        }
    }

    private async Task SubmitAsync()
    {
        // Face extraction is slow; re-entry would double-submit the registration.
        if (isSubmitting)
        {
            return;
        }

        nameError = string.IsNullOrWhiteSpace(fullName) ? "Enter the member's full name." : null;
        photoError = photos.Count == 0 ? "Add at least one photo." : null;
        if (nameError is not null || photoError is not null)
        {
            submissionError = null;
            return; // Validation failures never clear the form.
        }

        isSubmitting = true;
        submissionError = null;
        notice = null;
        var name = fullName.Trim();
        var photoCount = photos.Count;
        var streams = new List<Stream>(photoCount);
        try
        {
            foreach (var photo in photos)
            {
                // Buffer each upload into memory before the application layer sees it.
                // Two reasons: Blazor's BrowserFileStream rejects synchronous reads
                // (the extractor's Image.Load reads synchronously), and a circuit-bound
                // stream must not stay open across the slow face-extraction call.
                // Mirrors how the preview path already materializes the file.
                await using var source = photo.File.OpenReadStream(MaxPhotoBytes);
                var buffer = new MemoryStream();
                await source.CopyToAsync(buffer);
                buffer.Position = 0;
                streams.Add(buffer);
            }

            // Mirror the console flow: one fresh DI scope per submission, handler
            // resolved from that scope, scope disposed when the submission ends.
            // Resolving the scoped handler from the circuit's own scope instead
            // would pin its scoped dependencies for the whole circuit lifetime.
            using var scope = ScopeFactory.CreateScope();
            var handler = scope.ServiceProvider.GetRequiredService<RegisterMemberCommandHandler>();
            var command = new RegisterMemberCommand(name, streams);
            var result = await handler.HandleAsync(command, CancellationToken.None);

            if (result.IsFailure)
            {
                // Keep every piece of form state; only the inline message changes.
                submissionError = MapError(result.Error);
                return;
            }

            notice = $"Member '{name}' was registered with {PhotoCountLabel(photoCount)}.";
            noticeIsError = false;
            fullName = string.Empty;
            photos.Clear();
            nameError = null;
            photoError = null;
            selectionError = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Member registration submission failed.");
            submissionError = $"An unexpected error occurred: {ex.Message}";
        }
        finally
        {
            foreach (var stream in streams)
            {
                try
                {
                    await stream.DisposeAsync();
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to dispose a photo stream after submission.");
                }
            }

            isSubmitting = false;
        }
    }

    /// <summary>Every <see cref="RegisterMemberError"/> maps to a specific inline message.</summary>
    private static string MapError(RegisterMemberFailure failure) => failure.Error switch
    {
        RegisterMemberError.NoFaceDetected =>
            "No face was detected in at least one photo. Use a clear photo that shows a single face.",
        RegisterMemberError.MultipleFacesDetected =>
            "More than one face was detected in at least one photo. Use photos that show only one person.",
        RegisterMemberError.ExtractionFailed =>
            "At least one photo could not be processed. Try a different photo.",
        RegisterMemberError.InvalidMember =>
            "The member could not be created. Check the full name and photos, then try again.",
        RegisterMemberError.InvalidName =>
            "The full name is not valid. Enter the member's full name.",
        RegisterMemberError.MatchesOtherMember when !string.IsNullOrWhiteSpace(failure.MatchedMemberName) =>
            $"This face appears to already be registered to {failure.MatchedMemberName}. Use a photo of the new member.",
        RegisterMemberError.MatchesOtherMember =>
            "This face appears to already be registered to another member. Use a photo of the new member.",
        _ => "Registration failed. Please try again."
    };

    private static string PreviewFormat(string fileName) =>
        Path.GetExtension(fileName).Equals(".png", StringComparison.OrdinalIgnoreCase) ? "image/png" : "image/jpeg";

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1_048_576 => $"{bytes / 1_048_576.0:0.#} MB",
        >= 1_024 => $"{bytes / 1_024.0:0.#} KB",
        _ => $"{bytes} B"
    };

    private static string PhotoCountLabel(int count) => count == 1 ? "1 photo" : $"{count} photos";

    private sealed class PhotoEntry(IBrowserFile file)
    {
        public Guid Id { get; } = Guid.NewGuid();

        public IBrowserFile File { get; } = file;

        public string? PreviewDataUrl { get; set; }
    }

    private void ArmAnnul(Member member)
    {
        if (isAnnulling)
        {
            return;
        }

        pendingAnnulId = member.Id;
        notice = null;
    }

    private void CancelAnnul()
    {
        if (isAnnulling)
        {
            return;
        }

        pendingAnnulId = null;
    }

    private async Task ConfirmAnnulAsync(Member member)
    {
        if (isAnnulling)
        {
            return;
        }

        isAnnulling = true;
        notice = null;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var repository = scope.ServiceProvider.GetRequiredService<IMemberVectorRepository>();
            await repository.SetAnnulledAsync(member.Id, true, CancellationToken.None);
            pendingAnnulId = null;
            await LoadAsync();
            // ListAllAsync already excludes annulled members (T1), so the row
            // disappears on refresh — no client-side filtering needed.
            notice = $"Member '{member.FullName}' was disabled.";
            noticeIsError = false;
        }
        catch (KeyNotFoundException)
        {
            notice = $"Member '{member.FullName}' was not found. It may already have been removed.";
            noticeIsError = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to annul member {MemberId}.", member.Id);
            notice = $"Could not disable '{member.FullName}'. Please try again.";
            noticeIsError = true;
        }
        finally
        {
            isAnnulling = false;
        }
    }
}
