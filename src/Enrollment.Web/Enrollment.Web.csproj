  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FaceAiSharp" />
    <PackageReference Include="FaceAiSharp.Bundle" />
    <!-- Native ONNX Runtime binaries; FaceAiSharp only brings the managed bindings -->
